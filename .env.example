# Sunucunuzun alan adı (DNS A kaydı bu sunucuyu göstermeli). Örn: uretim.firmaniz.com
DOMAIN=uretim.ornek.com
# Let's Encrypt sertifika bildirimleri için e-posta
ACME_EMAIL=bilgi@ornek.com
# Güçlü, rastgele bir veritabanı şifresi (örn: openssl rand -base64 32)
POSTGRES_PASSWORD=BURAYA-GUCLU-BIR-SIFRE-YAZIN
# Yeni firmaların kendi kendine kayıt olmasına izin (SaaS). Tek firma kullanacaksanız ilk kayıttan sonra false yapın.
ALLOW_SIGNUP=true
# Hareketsiz oturum süresi (saat) ve en uzun oturum süresi (gün)
SESSION_IDLE_HOURS=12
SESSION_MAX_DAYS=7
